# Normalize all text files to LF on commit
* text=auto eol=lf

# Explicitly declare the text files this project has
*.py        text eol=lf
*.js        text eol=lf
*.sh        text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.html      text eol=lf
*.css       text eol=lf

# Binary files — never diff or convert
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       binary
*.pdf       binary
*.zip       binary
*.tar.gz    binary
