#!/bin/sh
# Fast gate before a commit: no staged line may name a local home directory, the
# harness Python must lint clean, and the unit tests must pass (they run no model).
set -eu
cd "$(git rev-parse --show-toplevel)"

# Only added lines count; a removed or unchanged line never blocks a commit.
hits=$(git diff --cached -U0 --no-color | awk '
  /^diff --git/ { inhunk = 0 }
  /^@@/ { inhunk = 1; next }
  inhunk && /^\+/ { print substr($0, 2) }
' | grep -E '/home/[A-Za-z0-9_]' || true)
if [ -n "$hits" ]; then
  echo "pre-commit: refusing, a staged line names a local home directory:" >&2
  echo "$hits" | head -n 5 >&2
  echo "  use a relative path or a placeholder, then commit again." >&2
  exit 1
fi

# Ruff reads the harness Python only: staged .py files, never the run folders.
py=$(git diff --cached --name-only --diff-filter=ACMR -- '*.py' ':!runs')
if [ -n "$py" ]; then
  echo "$py" | xargs uvx ruff@0.16.8 check
fi

# No bytecode is written, so a test run never dirties the tracked __pycache__ files.
PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests
